/target
.DS_Store

# pall8t's own agent worktrees (transient) and personal Claude Code settings.
# .claude/settings.json and .claude/skills/ ARE tracked; only these are not.
.claude/worktrees/
.claude/settings.local.json

# Serena (LSP MCP server) writes per-project config/memories here on activation.
.serena/

# cargo-mutants run output (reports, not sources).
/mutants.out
/mutants.out.old

# Python bytecode from running scripts/ and contrib/ by hand. Committed
# twice by `git add -A` after a `py_compile` before this line existed.
__pycache__/
*.pyc
